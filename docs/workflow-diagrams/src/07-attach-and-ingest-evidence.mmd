---
title: 07 · Attach and ingest evidence
---
flowchart TD
    A(["Attach DOCX +<br/>import prompt"]) --> B["POST /chat/with-attachment"]
    B --> C["Agent security screen and<br/>ingest-intent check"]
    C --> D{"Allowed import<br/>request?"}
    D -- no --> E(["Reject without parsing<br/>or indexing"])
    D -- yes --> F["Validate filename, size, ZIP<br/>structure, and document.xml"]
    F --> G["Stage upload under<br/>randomized private path"]
    G --> H["Serialize original OOXML<br/>paragraphs and markings"]
    H --> I["Screen document and cards<br/>for indirect injection"]
    I --> J["Boundary detection: optional model<br/>or deterministic fallback"]
    J --> K["Field labeling: optional model<br/>or deterministic fallback"]
    K --> L["Reconstruct citation, tag, body,<br/>read spans, emphasis spans"]
    L --> M["Run deterministic validation<br/>and source hash"]
    M --> N["Return preview and single-use<br/>confirmation token"]
    N --> O{"User confirms?"}
    O -- no --> P(["Nothing enters retrieval"])
    O -- yes --> Q["POST /ingest/confirm"]
    Q --> R["Recheck token, caller context,<br/>validation, and source hash"]
    R --> S(["Index valid non-quarantined<br/>cards atomically"])
    R --> T(["Keep risky cards quarantined<br/>and out of search"])

