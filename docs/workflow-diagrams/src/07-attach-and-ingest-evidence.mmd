    classDef pending fill:#FFF7E8,color:#65440A,stroke:#D69B2D,stroke-width:1.5px;
    classDef terminal fill:#E8F7EE,color:#164E2C,stroke:#3D9B63,stroke-width:2px;
    classDef quarantine fill:#F2EEFF,color:#45247A,stroke:#8B66C6,stroke-width:2px;
    class A entry;
    class D,O decision;
    class E guard;
    class N,Q pending;
    class P,S terminal;
    class T quarantine;
