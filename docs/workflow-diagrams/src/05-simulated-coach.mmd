---
title: 05 · Simulated coach
---
flowchart TD
    A(["Start or continue coaching"]) --> B{"Side and speech<br/>focus supplied?"}
    B -- no --> C["Ask a session-bound<br/>clarification"]
    B -- yes --> D["Read student's<br/>latest progress"]
    D --> E["Choose weakness tag or<br/>requested speech focus"]
    E --> F["Retrieve two cards for the<br/>active side and resolution"]
    F --> G["Extract bounded read and emphasis<br/>excerpts from both cards"]
    G --> H{"Anthropic configured<br/>and safe?"}
    H -- yes --> I["Generate one schema-validated<br/>feedback turn and question"]
    H -- no --> J["Use deterministic<br/>coaching turn"]
    I --> K["Return labeled<br/>simulated-coach turn"]
    J --> K
    K --> L["Render both full cards with citation<br/>and marked source text"]
    L --> M["Save coaching session<br/>for next reply"]
    M --> N{"Next message"}
    N -- student reply --> D
    N -- end coaching --> O(["Clear session"])
    N -- twelve-turn limit --> O

    classDef entry fill:#102A43,color:#FFFFFF,stroke:#102A43,stroke-width:2px;
    classDef decision fill:#FFF3D6,color:#563B00,stroke:#C98A13,stroke-width:2px;
    classDef pending fill:#FFF7E8,color:#65440A,stroke:#D69B2D,stroke-width:1.5px;
    classDef model fill:#F0EAFE,color:#3E236A,stroke:#8B66C6,stroke-width:2px;
    classDef fallback fill:#F1F5F9,color:#334155,stroke:#7C8B9D,stroke-width:1.5px;
    classDef terminal fill:#E8F7EE,color:#164E2C,stroke:#3D9B63,stroke-width:2px;
    class A entry;
    class B,H,N decision;
    class C pending;
    class I model;
    class J fallback;
    class O terminal;
