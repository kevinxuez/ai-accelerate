---
title: 04 · Generate a drill
---
flowchart TD
    A(["Drill request"]) --> B{"Side supplied?"}
    B -- no --> C["Ask for Pro or Con"]
    B -- yes --> D["Use named speech position<br/>or general"]
    D --> E["Read the student's latest<br/>progress record"]
    E --> F{"Weakness tags<br/>present?"}
    F -- yes --> G["Use weakness tags as<br/>retrieval query"]
    F -- no --> H["Use speech-position<br/>evidence query"]
    G --> I["Retrieve up to three cards<br/>for side and resolution"]
    H --> I
    I --> J["Build deterministic<br/>practice instructions"]
    J --> K(["Return drill plus<br/>cited card references"])

    classDef entry fill:#102A43,color:#FFFFFF,stroke:#102A43,stroke-width:2px;
    classDef decision fill:#FFF3D6,color:#563B00,stroke:#C98A13,stroke-width:2px;
    classDef pending fill:#FFF7E8,color:#65440A,stroke:#D69B2D,stroke-width:1.5px;
    classDef terminal fill:#E8F7EE,color:#164E2C,stroke:#3D9B63,stroke-width:2px;
    class A entry;
    class B,F decision;
    class C pending;
    class K terminal;
