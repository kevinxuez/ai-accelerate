---
title: 08 · Schedule a session
---
flowchart TD
    A(["Scheduling request"]) --> B{"Start time<br/>supplied?"}
    B -- no --> C["Ask for ISO start time"]
    B -- yes --> D["Validate owner, time, duration,<br/>timezone, and attendee"]
    D --> E{"MOCK_CALENDAR"}
    E -- true --> F["Write local calendar_events.json<br/>immediately"]
    E -- false --> G["Stage Google event and return<br/>confirmation token"]
    G --> H["Explicit confirmation request"]
    H --> I["Verify single-use token<br/>belongs to caller"]
    I --> J["Create Google Calendar event"]
    F --> K(["Audit and return event"])
    J --> K

    classDef entry fill:#102A43,color:#FFFFFF,stroke:#102A43,stroke-width:2px;
    classDef decision fill:#FFF3D6,color:#563B00,stroke:#C98A13,stroke-width:2px;
    classDef pending fill:#FFF7E8,color:#65440A,stroke:#D69B2D,stroke-width:1.5px;
    classDef write fill:#F0EAFE,color:#3E236A,stroke:#8B66C6,stroke-width:2px;
    classDef terminal fill:#E8F7EE,color:#164E2C,stroke:#3D9B63,stroke-width:2px;
    class A entry;
    class B,E decision;
    class C,G,H,I pending;
    class F,J write;
    class K terminal;
