# Azure-hosted Anthropic configuration for LLM-backed classification,
# boundary detection, field labeling, and eval judging.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://aibootcamp-claude.services.ai.azure.com/anthropic
CASEFILE_MODEL=claude-sonnet-4-6
TOKENIZERS_PARALLELISM=false

# Azure OpenAI deployments. These are available for future chat and embedding
# providers; the current CaseFile runtime uses Anthropic and local embeddings.
AZURE_OPENAI_ENDPOINT=https://ai-acceleratebootcamp.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-ada-002

# Safe demo defaults. Set to false only after Google OAuth is configured.
MOCK_CALENDAR=true
GOOGLE_CALENDAR_CREDENTIALS=credentials.json
GOOGLE_CALENDAR_TOKEN=token.json

# Synthetic NSDA provider. With NSDA_BASE_URL unset, the bundled validated mock dataset is
# used. Point this at an NSDA-compatible HTTPS mock service to exercise the HTTP adapter.
NSDA_BASE_URL=
NSDA_API_KEY=
NSDA_TIMEOUT_SECONDS=5
NSDA_MOCK_DATA=casefile/providers/nsda_mock.json

# Runtime paths may be overridden for isolated deployments/tests.
CASEFILE_DATA_DIR=casefile/data
CASEFILE_CHROMA_DIR=casefile/chroma_db
CASEFILE_RULES_DIR=casefile/rules
CASEFILE_MIN_RELEVANCE=0.08
CASEFILE_INGEST_ROOTS=background
CASEFILE_MAX_UPLOAD_BYTES=10485760
CASEFILE_REQUESTS_PER_MINUTE=60
