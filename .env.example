# Required Anthropic-compatible model configuration.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CASEFILE_MODEL=claude-sonnet-4-6
CASEFILE_MODEL_TIMEOUT_SECONDS=90
CASEFILE_EXPOSE_MODEL_PROMPTS=false
TOKENIZERS_PARALLELISM=false

# Optional providers are disabled until explicitly selected.
# Calendar values: disabled, fixture, google.
CASEFILE_CALENDAR_PROVIDER=disabled
GOOGLE_CALENDAR_CREDENTIALS=credentials.json
GOOGLE_CALENDAR_TOKEN=token.json

# NSDA-compatible values: disabled, fixture, http.
CASEFILE_NSDA_PROVIDER=disabled
CASEFILE_NSDA_FIXTURE_PATH=casefile/providers/nsda_fixture.json
NSDA_BASE_URL=
NSDA_API_KEY=
NSDA_TIMEOUT_SECONDS=5

# Runtime and required retrieval paths.
CASEFILE_DATA_DIR=casefile/data
CASEFILE_CHROMA_DIR=casefile/chroma_db
CASEFILE_EMBEDDING_MODEL_PATH=casefile/embedding_models/all-MiniLM-L6-v2
CASEFILE_RULES_DIR=casefile/rules
CASEFILE_MIN_RELEVANCE=0.08
CASEFILE_INGEST_ROOTS=background
CASEFILE_MAX_UPLOAD_BYTES=10485760
CASEFILE_REQUESTS_PER_MINUTE=60
